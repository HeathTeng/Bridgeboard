{
  "name": "bridgeboard",
  "version": "0.3.7",
  "description": "A local web dashboard for Blackboard Learn Ultra: deadlines, announcements, grades and a calendar feed, built on blackboard-mcp.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
    "test": "node --test test/*.test.js",
    "vendor": "esbuild ../blackboard-mcp/dist/index.js --bundle --format=esm --platform=node --target=node22 --outfile=vendor/blackboard-mcp.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
